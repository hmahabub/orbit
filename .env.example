# Copy to .env and fill in. .env is not committed to git.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
ORBIT_SECRET_KEY=change-me

# 1 = development (error pages, auto static files); 0 = live site.
ORBIT_DEBUG=0

# Comma-separated host names the site answers on.
ORBIT_ALLOWED_HOSTS=orbit.asgroupbd.com,localhost,127.0.0.1

# Comma-separated origins allowed to post forms (scheme included).
ORBIT_CSRF_TRUSTED_ORIGINS=https://orbit.asgroupbd.com
