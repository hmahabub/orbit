# Copy to .env and fill in. .env is not committed to git.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
ORBIT_SECRET_KEY=change-me

# 1 = development (error pages, auto static files); 0 = live site.
ORBIT_DEBUG=0

# Comma-separated host names the site answers on.
ORBIT_ALLOWED_HOSTS=orbit.asgroupbd.com,localhost,127.0.0.1

# Comma-separated origins allowed to post forms (scheme included).
ORBIT_CSRF_TRUSTED_ORIGINS=https://orbit.asgroupbd.com

# ---- Database ----
# sqlite (default), postgresql or mysql.
ORBIT_DB_ENGINE=sqlite
# SQLite: the database file, relative to the project folder.
# PostgreSQL / MySQL: the database name.
ORBIT_DB_NAME=db.sqlite3
# PostgreSQL / MySQL only (needs the psycopg or mysqlclient package):
ORBIT_DB_USER=
ORBIT_DB_PASSWORD=
ORBIT_DB_HOST=localhost
ORBIT_DB_PORT=

# ---- Letterhead (Excel supplier PO and cost sheet) ----
ORBIT_COMPANY_NAME=Orbit
ORBIT_COMPANY_ADDRESS=Faisal Dastagir Complex, North Kattali, Pahartoli, Chattogram, Bangladesh
# Logo image, relative to the project folder.
ORBIT_COMPANY_LOGO=static/image/orbit_logo.png
